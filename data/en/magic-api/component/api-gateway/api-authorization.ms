 : _createCommentVNode(\"v-if\", true)\n            ], 64 /* STABLE_FRAGMENT */))\n          : _createCommentVNode(\"v-if\", true)\n      ]),\n      _: 1 /* STABLE */\n    }, 8 /* PROPS */, [\"title\"])\n  ]))\n}\n}\n\n}\n__sfc__.__scopeId = \"data-v-9ee9cf3eaa\"\n__sfc__.__file = \"9ee9cf3eaa.vue\"\nreturn __sfc__",
  "compileCss": ".search-row[data-v-9ee9cf3eaa] { padding: 8px 0;\n}\n.doc-code[data-v-9ee9cf3eaa] {\n  background: #f6f8fa;\n  border: 1px solid #e6e8eb;\n  border-radius: 4px;\n  padding: 10px 12px;\n  margin: 0;\n  overflow: auto;\n  max-height: 320px;\n  font-size: 12px;\n  line-height: 1.6;\n  font-family: 'JetBrains Mono', Consolas, monospace;\n  color: #24292f;\n  white-space: pre;\n}",
  "group": null
}
================================
<template>
  <div class="mb-list">
    <div class="mb-search">
      <n-space>
        <n-select v-model:value="currentAppId" :options="appOptions" placeholder="Select an app" clearable style="width:280px" @update:value="onAppChange" />
        <n-input v-model:value="filterApiPath" placeholder="检索接口路径" clearable style="width:200px" @keyup.enter="doSearch" />
        <n-input v-model:value="filterApiName" placeholder="检索接口名称" clearable style="width:200px" @keyup.enter="doSearch" />
        <n-button type="primary" @click="doSearch">
          <mb-icon icon="Search" /> 查询
        </n-button>
        <n-button @click="doReset">
          <mb-icon icon="Refresh" /> 重置
        </n-button>
      </n-space>
    </div>
    <div class="mb-toolbar">
      <n-button type="primary" :disabled="!currentAppId" @click="handleBatchAdd">
        <mb-icon icon="AddOutline" /> 批量添加
      </n-button>
    </div>
    <div class="mb-table">
      <mb-table ref="table" v-bind="tableOptions" />
    </div>

    <mb-modal ref="batchDialog" title="批量添加接口授权" width="780px" @confirm="saveBatch($event)">
      <div style="margin-bottom: 12px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap">
        <n-input v-model:value="batchSearchKeyword" placeholder="快速检索：路径 / 名称 / 分组" clearable style="flex:1; min-width:260px">
          <template #prefix>
            <mb-icon icon="Search" />
          </template>
        </n-input>
        <span style="color:#999; font-size:12px">已选 <b style="color:#18a058">{{ batchSelectedCount }}</b> 个接口</span>
      </div>

      <div style="margin-bottom: 12px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap">
        <n-checkbox v-model:checked="batchRateLimitSwitch" @update:checked="(v) => !v && (batchRateLimit = null)">
          自定义统一限流（次）
        </n-checkbox>
        <n-input-number v-model:value="batchRateLimit" :disabled="!batchRateLimitSwitch" placeholder="留空=继承应用配置" :min="1" style="width: 160px" />
        <n-divider vertical />
        <span style="color:#999; font-size:12px">统一窗口（秒）</span>
        <n-input-number v-model:value="batchRateDuration" placeholder="Default 60" :min="1" style="width: 160px" />
      </div>

      <div style="border: 1px solid #e6e8eb; border-radius: 4px; max-height: 420px; overflow: auto">
        <n-tree
          block-line
          selectable
          checkable
          cascade
          :data="filteredCatalogTreeChildren"
          :pattern="batchSearchKeyword"
          :render-switcher-icon="renderSwitcherIcon"
          :render-label="renderTreeLabel"
          :key-field="'key'"
          :children-field="'children'"
          :label-field="'name'"
          :default-expand-all="!batchSearchKeyword"
          v-model:checked-keys="batchCheckedKeys"
          v-model:expanded-keys="batchExpandedKeys"
          @update:checked="onBatchCheckedChange"
        />
        <div v-if="filteredCatalogTree.children && filteredCatalogTree.children.length === 0" style="text-align: center; padding: 60px; color: #999">
          暂无可授权的后端接口
        </div>
      </div>

      <n-alert v-if="batchSelectedCount > 0" type="info" :show-icon="false" style="margin-top: 12px">
        将为 <b>{{ currentAppName }}</b> 授权以下接口：
        <div style="margin-top: 4px; max-height: 100px; overflow-y: auto; font-size: 12px">
          <div v-for="row in batchSelectedLeaves" :key="row.path + row.method" style="color:#555; padding: 2px 0">
            · <span style="color:#999">[{{ row.method }}]</span> {{ row.displayName }} <span style="color:#bbb; font-size: 11px">({{ row.path }})</span>
          </div>
        </div>
      </n-alert>
    </mb-modal>

    <mb-modal ref="editDialog" title="修改接口授权" width="600px" @confirm="saveEdit($event)">
      <n-form ref="editForm" :model="editTemp" label-placement="left" label-width="100px">
        <n-form-item label="API path">
          <n-input :value="editTemp.api_path" disabled />
        </n-form-item>
        <n-form-item label="HTTP方法">
          <n-input :value="editTemp.api_method" disabled />
        </n-form-item>
        <n-form-item label="API name">
          <n-input v-model:value="editTemp.api_name" placeholder="选填，便于识别" />
        </n-form-item>
        <n-grid :cols="2">
          <n-gi>
            <n-form-item label="Rate limit" path="rate_limit">
              <n-input-number v-model:value="editTemp.rate_limit" :min="1" placeholder="继承应用配置" style="width:100%" />
            </n-form-item>
          </n-gi>
          <n-gi>
            <n-form-item label="Rate limit window (s)" path="rate_duration">
              <n-input-number v-model:value="editTemp.rate_duration" :min="1" placeholder="Default 60" style="width:100%" />
            </n-form-item>
          </n-gi>
        </n-grid>
        <n-form-item label="Status" path="status">
          <n-switch v-model:value="editTemp.status" :checked-value="1" :unchecked-value="0" />
        </n-form-item>
      </n-form>
    </mb-modal>

    <mb-modal ref="detailDialog" :title="detailTitle" width="760px" :show-footer="false">
      <template v-if="detailData">
        <n-descriptions :column="2" bordered size="small" label-placement="left">
          <n-descriptions-item label="API path">
            <span style="font-family: monospace">{{ detailData.apiPath }}</span>
          </n-descriptions-item>
          <n-descriptions-item label="请求方式">
            <n-tag size="small" type="info" :bordered="false">{{ detailData.apiMethod }}</n-tag>
          </n-descriptions-item>
          <n-descriptions-item label="API name">
            {{ detailData.apiName || '-' }}
          </n-descriptions-item>
          <n-descriptions-item label="限流配置">
            {{ detailData.rateLimit ? detailData.rateLimit + ' 次 / ' + (detailData.rateDuration || 60) + ' 秒' : '继承应用配置' }}
          </n-descriptions-item>
          <n-descriptions-item label="Status">
            <n-tag size="small" :type="detailData.status === 1 ? 'success' : 'error'" :bordered="false">
              {{ detailData.status === 1 ? 'Enable' : '停用' }}
            </n-tag>
          </n-descriptions-item>
        </n-descriptions>

        <div v-if="detailData.description" style="margin-top: 16px">
          <div style="font-weight: 600; margin-bottom: 6px; color:#333">接口说明</div>
          <div style="color:#555; line-height:1.7">{{ detailData.description }}</div>
        </div>

        <template v-if="detailData.parameters && detailData.parameters.length > 0">
          <div style="font-weight: 600; margin: 16px 0 6px; color:#333">请求参数</div>
          <n-data-table
            :columns="paramColumns"
            :data="detailData.parameters"
            :pagination="false"
            :bordered="true"
            size="small"
          />
        </template>

        <div v-if="detailData.requestBody" style="margin-top: 16px">
          <div style="font-weight: 600; margin-bottom: 6px; color:#333">请求体（JSON）</div>
          <pre class="doc-code"><code>{{ detailData.requestBody }}</code></pre>
        </div>

        <div v-if="detailData.responseBody" style="margin-top: 16px">
          <div style="font-weight: 600; margin-bottom: 6px; color:#333">返回值（JSON）</div>
          <pre class="doc-code"><code>{{ detailData.responseBody }}</code></pre>
        </div>

        <n-empty v-if="!detailData.parameters.length && !detailData.requestBody && !detailData.responseBody && !detailData.description" description="该接口未配置文档说明" style="margin-top: 24px" />
      </template>
    </mb-modal>
  </div>
</template>

<style scoped>
.search-row { padding: 8px 0; }
.doc-code {
  background: #f6f8fa;
  border: 1px solid #e6e8eb;
  border-radius: 4px;
  padding: 10px 12px;
  margin: 0;
  overflow: auto;
  max-height: 320px;
  font-size: 12px;
  line-height: 1.6;
  font-family: 'JetBrains Mono', Consolas, monospace;
  color: #24292f;
  white-space: pre;
}
</style>

<script setup>
import { ref, reactive, computed, nextTick, onMounted, h } from 'vue'
import { NIcon, NCheckbox, NTag } from 'naive-ui'

const appOptions = ref([])
const currentAppId = ref(null)
const filterApiPath = ref('')
const filterApiName = ref('')

const currentAppName = computed(() => {
  const item = appOptions.value.find(it => it.value === currentAppId.value)
  return item ? item.label : '(未选择)'
})

const tableOptions = reactive({
  id: 'open-app-api',
  url: '/system/open/app/api/list',
  page: true,
  where: {
    appId: { value: '' },
    apiPath: { value: '' },
    apiName: { value: '' }
  },
  cols: [
    { field: 'apiPath', label: 'API path', width: 260 },
    { field: 'apiName', label: 'API name', width: 200 },
    { field: 'apiMethod', label: 'Method', width: 70 },
    { field: 'rateLimit', label: 'Rate limit', width: 80 },
    { field: 'rateDuration', label: '窗口(秒)', width: 90 },
    { field: 'status', label: 'Status', type: 'switch', width: 80,
      change: (row) => updateApi(row) },
    {
      label: 'Operation', type: 'buttons', width: 200, fixed: 'right',
      buttons: [
        { label: 'Details', link: true, click: (row) => handleDetail(row) },
        { label: 'Update', link: true, click: (row) => handleEdit(row) },
        { label: 'Delete', link: true, click: (row) => {
          $common.handleDelete({ url: '/system/open/app/api/delete', id: row.id, done: () => reloadTable() })
        }}
      ]
    }
  ]
})

const table = ref()
const batchDialog = ref()
const editDialog = ref()
const editForm = ref()
const detailDialog = ref()
const detailData = ref(null)
const detailTitle = ref('接口文档')

const apiCatalogTree = ref({ name: 'api', children: [] })
const batchSearchKeyword = ref('')
const batchCheckedKeys = ref([])
const batchExpandedKeys = ref([])
const batchRateLimitSwitch = ref(false)
const batchRateLimit = ref(null)
const batchRateDuration = ref(60)

const editTemp = ref(getEditTemp())

const flatAllLeaves = ref([])

const filteredCatalogTree = computed(() => {
  if (!batchSearchKeyword.value || !batchSearchKeyword.value.trim()) {
    return apiCatalogTree.value
  }
  return filterTree(apiCatalogTree.value, batchSearchKeyword.value.trim().toLowerCase()) || { name: 'api', children: [] }
})

const filteredCatalogTreeChildren = computed(() => {
  const t = filteredCatalogTree.value
  return (t && t.children) || []
})

const batchSelectedLeaves = computed(() => {
  const set = new Set(batchCheckedKeys.value)
  return flatAllLeaves.value.filter(l => set.has(l.key))
})

const batchSelectedCount = computed(() => batchSelectedLeaves.value.length)

function getEditTemp() {
  return { id: '', app_id: '', api_path: '', api_name: '', api_method: '', rate_limit: null, rate_duration: 60, status: 1 }
}

function reloadTable() {
  tableOptions.where.appId = currentAppId.value || ''
  tableOptions.where.apiPath = filterApiPath.value || ''
  tableOptions.where.apiName = filterApiName.value || ''
  if (table.value) table.value.reload()
}

function onAppChange() {
  reloadTable()
}

function doSearch() {
  reloadTable()
}

function doReset() {
  filterApiPath.value = ''
  filterApiName.value = ''
  reloadTable()
}

function loadApps() {
  $common.post('/system/open/app/list', {}).then(res => {
    const list = res?.data?.list || []
    appOptions.value = list.map(item => ({
      label: `${item.appName} (${item.appKey})`,
      value: item.id
    }))
  })
}

function loadCatalog() {
  $common.get('/system/open/app/api/catalog', { app_id: currentAppId.value }).then(res => {
    const data = Array.isArray(res) ? res : (res?.data || { children: [] })
    apiCatalogTree.value = data && data.children ? data : { name: 'api', children: [] }
    flatAllLeaves.value = collectLeaves(apiCatalogTree.value)
  })
}

function collectLeaves(node, parent) {
  const out = []
  if (!node) return out
  if (node.type === 'api' && node.path) {
    const groupPath = parent || ''
    out.push({
      key: node.key,
      path: node.path,
      method: node.method,
      name: node.name,
      group: groupPath,
      displayName: (groupPath ? groupPath + '/' : '') + (node.name || '')
    })
    return out
  }
  const newParent = parent ? (node.name ? parent + '/' + node.name : parent) : (node.name || '')
  if (node.children) {
    for (const c of node.children) {
      out.push(...collectLeaves(c, newParent))
    }
  }
  return out
}

function filterTree(node, kw) {
  if (!node) return null
  if (node.type === 'api' && node.path) {
    const text = (node.path + ' ' + node.method + ' ' + (node.name || '')).toLowerCase()
    return text.includes(kw) ? node : null
  }
  if (!node.children) return null
  const kept = []
  for (const c of node.children) {
    const f = filterTree(c, kw)
    if (f) kept.push(f)
  }
  if (kept.length === 0 && node.name && node.name.toLowerCase().includes(kw)) {
    return { ...node, children: kept }
  }
  return kept.length > 0 ? { ...node, children: kept } : null
}

function renderSwitcherIcon() {
  return h(NIcon, null, { default: () => h('span', '▶') })
}

function renderTreeLabel(info) {
  const node = info.option || info.node
  if (!node) return null
  if (node.type === 'api') {
    return h('span', { style: 'display:inline-flex; align-items:center; gap:8px;' }, [
      h(NTag, { size: 'small', type: 'default', bordered: false, round: true }, { default: () => node.method || 'GET' }),
      h('span', { style: 'color:#0066cc; font-family:monospace;' }, node.path),
      h('span', { style: 'color:#666; font-size:12px;' }, node.name || '')
    ])
  }
  return h('span', { style: 'font-weight:500; color:#333' }, node.name)
}

function onBatchCheckedChange(keys, options) {
  batchCheckedKeys.value = keys
}

function handleBatchAdd() {
  batchSearchKeyword.value = ''
  batchCheckedKeys.value = []
  batchExpandedKeys.value = []
  batchRateLimit.value = null
  batchRateLimitSwitch.value = false
  batchRateDuration.value = 60
  loadCatalog()
  batchDialog.value.show()
}

function saveBatch(d) {
  const leaves = batchSelectedLeaves.value
  if (leaves.length === 0) {
    $message.warning('请至少选择一个接口')
    d.hideLoading()
    setTimeout(() => batchDialog.value.show(), 0)
    return
  }
  d.loading()
  const items = leaves.map(leaf => ({
    api_path: leaf.path,
    api_name: leaf.displayName,
    api_method: leaf.method,
    status: 1,
    rate_limit: batchRateLimitSwitch.value ? batchRateLimit.value : null,
    rate_duration: batchRateDuration.value
  }))
  $common.postJson('/system/open/app/api/save-batch', {
    app_id: currentAppId.value,
    items: items
  }).then(res => {
    d.hideLoading()
    batchDialog.value.hide()
    const data = res?.data || {}
    $message.success(`成功：新增 ${data.added || 0} 条${data.skipped ? `，跳过 ${data.skipped} 条（已存在）` : ''}`)
    reloadTable()
  }).catch(() => d.hideLoading())
}

const paramColumns = [
  { title: '参数名', key: 'name', width: 160 },
  { title: 'Type', key: 'dataType', width: 100 },
  { title: '必填', key: 'required', width: 70, render: (row) => h(NTag, { size: 'small', type: row.required ? 'error' : 'default', bordered: false }, { default: () => row.required ? 'Yes' : 'No' }) },
  { title: 'Default value', key: 'defaultValue', width: 110, render: (row) => row.defaultValue != null ? String(row.defaultValue) : '-' },
  { title: '说明', key: 'description', render: (row) => row.description || '-' }
]

function handleDetail(row) {
  detailData.value = null
  detailTitle.value = `接口文档：${row.apiPath || ''}`
  detailDialog.value.show()
  $common.get('/system/open/app/api/detail', {
    app_id: row.appId || currentAppId.value,
    api_path: row.apiPath,
    api_method: row.apiMethod
  }).then(res => {
    const data = res?.data || {}
    if (data.found === false) {
      detailData.value = {
        apiPath: row.apiPath,
        apiMethod: row.apiMethod,
        apiName: row.apiName || '',
        rateLimit: row.rateLimit,
        rateDuration: row.rateDuration,
        status: row.status,
        description: '',
        parameters: [],
        requestBody: '',
        responseBody: ''
      }
      $message.warning('未找到该接口授权记录')
      return
    }
    detailData.value = data
  })
}

function handleEdit(row) {  editTemp.value = {
    id: row.id,
    app_id: row.appId,
    api_path: row.apiPath,
    api_name: row.apiName,
    api_method: row.apiMethod,
    rate_limit: row.rateLimit,
    rate_duration: row.rateDuration,
    status: row.status
  }
  editDialog.value.show()
  nextTick(() => editForm.value && editForm.value.restoreValidation && editForm.value.restoreValidation())
}

function saveEdit(d) {
  d.loading()
  $common.post('/system/open/app/api/save', {
    id: editTemp.value.id,
    app_id: editTemp.value.app_id,
    api_path: editTemp.value.api_path,
    api_name: editTemp.value.api_name,
    api_method: editTemp.value.api_method,
    rate_limit: editTemp.value.rate_limit,
    rate_duration: editTemp.value.rate_duration,
    status: editTemp.value.status
  }).then(() => {
    d.hideLoading()
    editDialog.value.hide()
    $message.success('Updated successfully')
    reloadTable()
  }).catch(() => d.hideLoading())
}

function updateApi(row) {
  $common.post('/system/open/app/api/save', {
    id: row.id,
    app_id: row.appId,
    api_path: row.apiPath,
    api_name: row.apiName,
    api_method: row.apiMethod,
    rate_limit: row.rateLimit,
    rate_duration: row.rateDuration,
    status: row.status
  })
}

onMounted(() => {
  loadApps()
})
</script>
