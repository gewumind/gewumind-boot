                  })\n                    ]),\n                    _: 1 /* STABLE */\n                  }),\n                  _createVNode(_component_n_descriptions_item, { label: \"API name\" }, {\n                    default: _withCtx(() => [\n                      _createTextVNode(_toDisplayString(detailData.value.apiName || '-'), 1 /* TEXT */)\n                    ]),\n                    _: 1 /* STABLE */\n                  }),\n                  _createVNode(_component_n_descriptions_item, { label: \"限流配置\" }, {\n                    default: _withCtx(() => [\n                      _createTextVNode(_toDisplayString(detailData.value.rateLimit ? detailData.value.rateLimit + ' 次 / ' + (detailData.value.rateDuration || 60) + ' 秒' : '继承应用配置'), 1 /* TEXT */)\n                    ]),\n                    _: 1 /* STABLE */\n                  }),\n                  _createVNode(_component_n_descriptions_item, { label: \"Status\" }, {\n                    default: _withCtx(() => [\n                      _createVNode(_unref(NTag), {\n                        size: \"small\",\n                        type: detailData.value.status === 1 ? 'success' : 'error',\n                        bordered: false\n                      }, {\n                        default: _withCtx(() => [\n                          _createTextVNode(_toDisplayString(detailData.value.status === 1 ? 'Enable' : '停用'), 1 /* TEXT */)\n                        ]),\n                        _: 1 /* STABLE */\n                      }, 8 /* PROPS */, [\"type\"])\n                    ]),\n                    _: 1 /* STABLE */\n                  })\n                ]),\n                _: 1 /* STABLE */\n              }),\n              (detailData.value.description)\n                ? (_openBlock(), _createElementBlock(\"div\", _hoisted_16, [\n                    _hoisted_17,\n                    _createElementVNode(\"div\", _hoisted_18, _toDisplayString(detailData.value.description), 1 /* TEXT */)\n               