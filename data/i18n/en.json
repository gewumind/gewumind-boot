    },
    {
      "regex": "^请输入(.+)$",
      "replace": "Please enter $1"
    },
    {
      "regex": "^请选择(.+)$",
      "replace": "Please select $1"
    },
    {
      "regex": "^共查到 (\\d+) 条记录$",
      "replace": "$1 records found"
    },
    {
      "regex": "^最多(\\d+)张$",
      "replace": "Up to $1 images"
    },
    {
      "regex": "^上传文件大小不能超过 (\\d+)MB！?$",
      "replace": "File size must not exceed $1 MB!"
    },
    {
      "regex": "^确认删除会话「(.+)」？此操作不可恢复。$",
      "replace": "Delete conversation \"$1\"? This cannot be undone."
    },
    {
      "regex": "^支持上传(.+)文件$",
      "replace": "Supported files: $1"
    }
  ]
