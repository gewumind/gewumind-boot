    "撤回失败": "Withdraw failed",
    "为什么驳回给我": "Why was it returned to me?",
    "我能审批哪些节点": "Which nodes can I approve?",
    "最大": "Max",
    "最小": "Min",
    "极光青": "Aurora Teal",
    "翡翠绿": "Emerald",
    "极简灰": "Minimal Gray",
    "活力橙": "Vibrant Orange",
    "樱花粉": "Sakura Pink",
    "朝霞红": "Dawn Red",
    "默认蓝": "Default Blue",
    "中国红": "China Red",
    "暗夜黑": "Midnight Black",
    "深邃蓝": "Deep Blue",
    "浪漫紫": "Romantic Purple",
    "琥珀金": "Amber Gold",
    "(未命名)": "(Untitled)",
    "(无标题)": "(No title)",
    "已通过": "Passed",
    "创建任务": "Create task"
  },
  "patterns": [
    {
      "regex": "^共 (\\d+) 条$",
      "replace": "$1 items"
    },
    {
      "regex": "^第 (\\d+) 页$",
      "replace": "Page $1"
    },
    {
      "regex": "^请输入(.+)$",
      "replace": "Please enter $1"
    },
    {
      "regex": "^请选择(.+)$",
      "replace": "Please select $1"
    },
    {
      "regex": "^共查到 (\\d+) 条记录$",
      "replace": "$1 records found"
    },
    {
      "regex": "^最多(\\d+)张$",
      "replace": "Up to $1 images"
    },
    {
      "regex": "^上传文件大小不能超过 (\\d+)MB！?$",
      "replace": "File size must not exceed $1 MB!"
    },
    {
      "regex": "^确认删除会话「(.+)」？此操作不可恢复。$",
      "replace": "Delete conversation \"$1\"? This cannot be undone."
    },
    {
      "regex": "^支持上传(.+)文件$",
      "replace": "Supported files: $1"
    },
    {
      "regex": "^(.+)属于商业版能力，当前授权未包含或已过期。$",
      "replace": "$1 is a commercial feature not included or expired in the current license."
    },
    {
      "regex": "^(.+) · 欢迎使用$",
      "replace": "$1 · Welcome"
    },
    {
      "regex": "^页面不存在：(.+)$",
      "replace": "Page not found: $1"
    },
    {
      "regex": "^发起一个(.+)$",
      "replace": "Start a $1"
    },
    {
      "regex": "^实例详情 · (.+)$",
      "replace": "Instance detail · $1"
    },
    {
      "regex": "^填写人：(.+)$",
      "replace": "Filled by: $1"
    },
    {
      "regex": "^实例 ID: (.+)$",
      "replace": "Instance ID: $1"
    },
    {
      "regex": "^已重新提交：流程进入「(.+)」$",
      "replace": "Resubmitted: process moved to \"$1\""
    },
    {
      "regex": "^已驳回，流程回到「(.+)」$",
      "replace": "Rejected: process returned to \"$1\""
    },
    {
      "regex": "^驳回原因（来自「(.+)」(.+)）$",
      "replace": "Rejection reason (from \"$1\"$2)"
    },
    {
      "regex": "^当前节点「(.+)」仅限 (.+) 编辑，您当前以「(.+)」身份查看，可只读浏览。$",
      "replace": "Current node \"$1\" is editable only by $2. You are viewing as \"$3\" (read-only)."
    },
    {
      "regex": "^最大(.+)$",
      "replace": "Max $1"
    },
    {
      "regex": "^最小(.+)$",
      "replace": "Min $1"
    },
    {
      "regex": "^如果 (.+)，进入「(.+)」$",
      "replace": "If $1, go to \"$2\""
    },
    {
      "regex": "^(.+?) (大于等于|小于等于|不等于|大于|小于|等于) (.+)$",
      "replace": "$1 $2 $3"
    },
    {
      "regex": "^(\\d[\\d,.]*) 元$",
      "replace": "$1 CNY"
    },
    {
      "regex": "^([^:：]{2,})[:：]\\s*(.*)$",
      "replace": "$1: $2"
    },
    {
      "regex": "^(.+) - 历史记录$",
      "replace": "$1 - History"
    },
    {
      "regex": "^已重新提交：流程进入「(.+)」等待重新填写$",
      "replace": "Resubmitted: process moved to \"$1\", awaiting refill"
    }
  ]
}