================================
<template>
    <div class="mb-list">
        <div class="ai-head">
            <div class="ai-head-main">
                <div class="ai-head-title"><mb-icon icon="AppsOutline" /> 工具目录</div>
                <div class="ai-head-desc">登记可供 AI 调用的只读接口与参数说明；仅启用且已授权给角色的接口才会被调用</div>
            </div>
            <div class="ai-head-actions">
            <n-button :size="uiSizeStore.uiSize" v-permission="'ai-tool:save'" type="primary" @click="handleCreate">
                <mb-icon icon="AddOutline" /> 添加工具
            </n-button>
            <n-button :size="uiSizeStore.uiSize" v-permission="'ai-tool:scan'" @click="handleScan">
                <mb-icon icon="SearchOutline" /> 扫描接口
            </n-button>
        
            </div>
        </div>
        <div class="ai-filter">
            <n-input v-model:value="searchKeyword" clearable placeholder="搜索 标识 / 名称 / 路径" style="width:260px" @keyup.enter="doSearch">
                <template #prefix><mb-icon icon="SearchOutline" /></template>
            </n-input>
            <n-select v-model:value="searchStatus" :options="statusFilterData" clearable placeholder="状态" style="width:120px"/>
            <n-button type="primary" size="small" @click="doSearch">查询</n-button>
            <n-button size="small" @click="resetFilter">重置</n-button>
        </div>
        <div class="mb-table">
            <mb-table ref="table" v-bind="tableOptions" :data="filteredToolRows"/>
        </div>

        <mb-modal ref="toolFormDialog" :title="dialogTitle" width="900px" @confirm="save($event)">
            <n-form :size="uiSizeStore.uiSize" ref="dataForm" :rules="rules" label-placement="left" :model="temp" label-width="110px">
                <n-grid :cols="24" :x-gap="24">
                    <n-gi :span="12">
                        <n-form-item label="工具标识" path="toolKey">
                            <n-input v-model:value="temp.toolKey" placeholder="如 order_list"/>
                        </n-form-item>
                    </n-gi>
                    <n-gi :span="12">
                        <n-form-item label="工具名称" path="name">
                            <n-input v-model:value="temp.name"/>
                        </n-form-item>
                    </n-gi>
                </n-grid>
                <n-grid :cols="24" :x-gap="24">
                    <n-gi :span="8">
                        <n-form-item label="请求方式" path="method">
                            <mb-select v-model="temp.method" :options="methodData"/>
                        </n-form-item>
                    </n-gi>
                    <n-gi :span="16">
                        <n-form-item label="接口路径" path="path">
                            <div style="display:flex;gap:8px;width:100%;">
                                <n-input v-model:value="temp.path" placeholder="/business/order/list" style="flex:1"/>
                                <n-button size="small" @click="openScan('fill')"><mb-icon icon="SearchOutline" /> 选择接口</n-button>
                            </div>
                        </n-form-item>
                    </n-gi>
                </n-grid>
                <n-grid :cols="24">
                    <n-gi :span="24">
                        <n-form-item label="接口说明" path="description">
                            <n-input type="textarea" :rows="3" v-model:value="temp.description" placeholder="给模型看的用途 / 入参 / 返回含义"/>
                        </n-form-item>
                    </n-gi>
                </n-grid>
                <n-grid :cols="24">
                    <n-gi :span="24">
                        <n-form-item label="入参 Schema" path="paramsSchema">
                            <n-input type="textarea" :rows="3" v-model:value="temp.paramsSchema" placeholder='{"type":"object","properties":{...}}'/>
                        </n-form-item>
                    </n-gi>
                </n-grid>
                <n-grid :cols="24">
                    <n-gi :span="24">
                        <n-form-item label="返回说明" path="responseSchema">
                            <n-input type="textarea" :rows="2" v-model:value="temp.responseSchema"/>
                        </n-form-item>
                    </n-gi>
                </n-grid>
                <n-grid :cols="24" :x-gap="24">
                    <n-gi :span="8">
                        <n-form-item path="sensitiveFields">
                            <template #label>
                                <span style="display:inline-flex;align-items:center;gap:4px;">敏感字段
                                    <n-tooltip trigger="hover" placement="top">
                                        <template #trigger><mb-icon icon="HelpCircleOutline" style="color:#8a919f;cursor:help;" /></template>
                                        说明：AI 回答前会对这些字段打码（如 138****0002），避免敏感信息发送给大模型；留空则不脱敏。字段名需与接口返回字段一致。
                                    </n-tooltip>
                                </span>
                            </template>
                            <n-input v-model:value="temp.sensitiveFields" placeholder="逗号分隔，如 phone, idCard"/>
                        </n-form-item>
                    </n-gi>
                    <n-gi :span="8">
                        <n-form-item label="状态" path="enabled">
                            <mb-select v-model="temp.enabled" :options="enabledData"/>
                        </n-form-item>
                    </n-gi>
                </n-grid>
                <n-grid :cols="24">
                    <n-gi :span="24">
                        <n-form-item label="备注" path="remarks">
                            <n-input v-model:value="temp.remarks"/>
                        </n-form-item>
                    </n-gi>
                </n-grid>
            </n-form>
        </mb-modal>

        <n-modal v-model:show="scanShow" preset="card" title="选择接口" style="width: 980px">
            <div style="margin-bottom:10px;display:flex;align-items:center;gap:10px;">
                <n-input v-model:value="scanKeyword" clearable placeholder="搜索 路径 / 名称 / 分组 / 方法" style="width:360px">
                    <template #prefix><mb-icon icon="SearchOutline" /></template>
                </n-input>
                <span style="color:#8a919f;font-size:12px;">共 {{ filteredScanData.length }} 个可用接口（已导入的不显示）</span>
            </div>
            <n-data-table :single-line="false" :bordered="false" :columns="scanCols" :data="filteredScanData" :max-height="440"/>
        </n-modal>

        <n-modal v-model:show="testShow" preset="card" :title="'试调用：' + testTool" style="width: 720px">
            <pre class="test-pre">{{ testResult }}</pre>
        </n-modal>
    </div>
</template>

<script setup>
import { useUiSizeStore } from "@/store/modules/uiSizeStore"
const uiSizeStore = useUiSizeStore()
import { ref, reactive, nextTick, h, computed } from 'vue'

const table = ref()
const toolFormDialog = ref()
const dataForm = ref()
const toolRows = ref([])
const dialogTitle = ref('')

const methodData = reactive([{ label: 'GET', value: 'GET' }, { label: 'POST', value: 'POST' }])
const enabledData = reactive([{ label: '启用', value: '1' }, { label: '停用', value: '0' }])
const statusFilterData = [{ label: '启用', value: 1 }, { label: '停用', value: 0 }]
const searchKeyword = ref('')
const searchStatus = ref(null)
const appliedKeyword = ref('')
const appliedStatus = ref(null)
const filteredToolRows = computed(() => {
    const kw = String(appliedKeyword.value || '').trim().toLowerCase()
    const st = appliedStatus.value
    return toolRows.value.filter(r => {
        if (st !== null && st !== undefined && String(st) !== '' && String(r.enabled) !== String(st)) return false
        if (!kw) return true
        return [r.toolKey, r.name, r.path].some(v => String(v || '').toLowerCase().includes(kw))
    })
})
function doSearch() { appliedKeyword.value = searchKeyword.value; appliedStatus.value = searchStatus.value }
function resetFilter() { searchKeyword.value = ''; searchStatus.value = null; appliedKeyword.value = ''; appliedStatus.value = null }

const tableOptions = reactive({
    id: 'ai-tool-list',
    rowKey: 'id',
    cols: [
        { field: 'toolKey', label: '工具标识', width: 140 },
        { field: 'name', label: '名称', width: 140 },
        { field: 'method', label: '方式', width: 70 },
        { field: 'path', label: '接口路径', minWidth: 180 },
        {
            field: 'enabled', label: '状态', width: 80,
            render: (row) => {
                const on = row.enabled == 1
                const c = on ? '#18a058' : '#909399'
                const label = on ? '启用' : '停用'
                return h('span', { style: `display:inline-block;padding:1px 9px;border-radius:10px;font-size:12px;line-height:20px;background:${c}1a;color:${c}` }, label)
            }
        },
        {
            label: '操作', type: 'buttons', width: 260, fixed: 'right',
            buttons: [
                { permission: 'ai-tool:save', label: '修改', link: true, click: (row) => handleUpdate(row) },
                { permission: 'ai-tool:save', label: '试调用', link: true, click: (row) => handleTest(row) },
                { permission: 'ai-tool:save', label: '启停', link: true, click: (row) => toggle(row) },
                { permission: 'ai-tool:delete', label: '删除', link: true, click: (row) => del(row) }
            ]
        }
    ]
})

const temp = ref(getTemp())
const rules = reactive({
    toolKey: { required: true, message: '请输入工具标识', trigger: 'blur' },
    name: { required: true, message: '请输入工具名称', trigger: 'blur' },
    path: { required: true, message: '请输入接口路径', trigger: 'blur' }
})

function getTemp() {
    return { id: '', toolKey: '', name: '', method: 'GET', path: '', description: '', paramsSchema: '', responseSchema: '', requiredPermission: '', scopeType: 'all', sensitiveFields: '', readOnly: 1, enabled: '1', remarks: '' }
}

function reload() {
    $common.get('/system/ai-tools/list').then(res => {
        toolRows.value = res.data || []
    }).catch(() => {})
}

function handleCreate() {
    temp.value = getTemp()
    dialogTitle.value = '添加工具'
    toolFormDialog.value.show()
    nextTick(() => dataForm.value.restoreValidation())
}

function handleUpdate(row) {
    temp.value = { ...getTemp(), ...row, enabled: String(row.enabled ?? '1') }
    dialogTitle.value = '修改工具'
    toolFormDialog.value.show()
    nextTick(() => dataForm.value.restoreValidation())
}

function save(d) {
    dataForm.value.validate((errors) => {
        if (!errors) {
            d.loading()
            $common.postJson('/system/ai-tools/save', temp.value).then(() => {
                d.hideLoading()
                toolFormDialog.value.hide()
                $message.success(dialogTitle.value + '成功')
                reload()
            }).catch(() => d.hideLoading())
        }
    })
}

function toggle(row) {
    const enabled = row.enabled != 1
    $common.postJson('/system/ai-tools/status', { id: row.id, enabled: enabled }).then(() => {
        $message.success('已' + (enabled ? '启用' : '停用'))
        reload()
    })
}

function del(row) {
    delAi('/system/ai-tools/delete', row.id, () => reload())
}

const testShow = ref(false)
const testTool = ref('')
const testResult = ref('')
function handleTest(row) {
    testTool.value = row.toolKey
    testResult.value = '调用中…'
    testShow.value = true
    $common.postJson('/system/ai-tools/test-call', { toolKey: row.toolKey, params: {} }).then(res => {
        testResult.value = JSON.stringify(res, null, 2)
    }).catch(e => {
        testResult.value = '调用失败：' + (e?.message || e)
    })
}

const scanShow = ref(false)
const scanData = ref([])
const scanKeyword = ref('')
const scanMode = ref('import')
const filteredScanData = computed(() => {
    const kw = String(scanKeyword.value || '').trim().toLowerCase()
    if (!kw) return scanData.value
    return scanData.value.filter(c => ((c.path || '') + ' ' + (c.name || '') + ' ' + (c.group || '') + ' ' + (c.method || '')).toLowerCase().includes(kw))
})
const scanCols = [
    { title: '接口路径', key: 'path', minWidth: 260 },
    { title: '方法', key: 'method', width: 80 },
    { title: '名称', key: 'name', width: 180 },
    { title: '分组', key: 'group', width: 200 },
    {
        title: '操作', key: 'op', width: 90,
        render: (row) => h('a', { style: 'color:#2d8cf0;cursor:pointer', onClick: () => onPick(row) }, scanMode.value === 'fill' ? '选择' : '导入')
    }
]

function openScan(mode) {
    scanMode.value = mode || 'import'
    scanKeyword.value = ''
    if (scanMode.value === 'fill') { try { toolFormDialog.value.hide() } catch (e) {} }
    $common.get('/system/ai-tools/catalog').then(res => {
        const importedSet = new Set(toolRows.value.map(t => String(t.method || 'GET').toUpperCase() + ' ' + String(t.path || '').trim()))
        scanData.value = (res.data || []).filter(c => !importedSet.has(String(c.method || 'GET').toUpperCase() + ' ' + String(c.path || '').trim()))
        scanShow.value = true
        if (!scanData.value.length) $message.warning('没有可导入的新接口（已全部导入）')
    }).catch(() => {
        scanData.value = []
        scanShow.value = true
        $message.warning('接口目录加载失败')
    })
}

function handleScan() { openScan('import') }

function deriveToolKey(path) {
    return String(path || '').replace(/^\/+/, '').replace(/[^a-zA-Z0-9]+/g, '_').replace(/_+/g, '_').replace(/^_+|_+$/g, '').toLowerCase() || 'tool'
}

function onPick(row) {
    if (scanMode.value === 'fill') {
        temp.value = {
            ...temp.value,
            method: row.method || 'GET',
            path: row.path || '',
            name: temp.value.name || row.name || '',
            toolKey: temp.value.toolKey || deriveToolKey(row.path),
            description: temp.value.description || row.description || row.name || '',
            paramsSchema: temp.value.paramsSchema || row.paramsSchema || '',
            responseSchema: temp.value.responseSchema || row.responseSchema || ''
        }
        scanShow.value = false
        nextTick(() => {
            toolFormDialog.value.show()
            nextTick(() => dataForm.value.restoreValidation())
        })
        return
    }
    importTool(row)
}

function importTool(row) {
    temp.value = {
        ...getTemp(),
        toolKey: row.toolKey || deriveToolKey(row.path),
        name: row.name || row.toolKey || deriveToolKey(row.path),
        method: row.method || 'GET',
        path: row.path || '',
        description: row.description || row.name || '',
        paramsSchema: row.paramsSchema || '',
        responseSchema: row.responseSchema || '',
        scopeType: 'all'
    }
    scanShow.value = false
    dialogTitle.value = '添加工具'
    toolFormDialog.value.show()
    nextTick(() => dataForm.value.restoreValidation())
}
reload()

function delAi(url, id, done) {
    $dialog.warning({
        title: '提示',
        content: '此操作将永久删除该数据, 是否继续?',
        positiveText: '确定',
        negativeText: '取消',
        onPositiveClick: () => {
            $common.postJson(url, { id: id }).then(() => {
                $message.success('删除成功')
                done && done()
            })
        }
    })
}
</script>

<style scoped>
.test-pre {
    max-height: 420px;
    overflow: auto;
    font-size: 12px;
    white-space: pre-wrap;
    word-break: break-all;
    background: var(--surface-soft);
    padding: 10px;
    border-radius: 6px;
}
.ai-filter { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:4px 0 12px; }
</style>


<style scoped>
.ai-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.ai-head-main { min-width: 0; }
.ai-head-title { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; line-height: 1.4; color: var(--n-text-color, #1f2225); }
.ai-head-desc { margin-top: 4px; font-size: 12px; line-height: 1.6; color: #8a919f; max-width: 720px; }
.ai-head-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
</style>
