<template>
    <div class="mb-list">
        <div class="mb-toolbar">
            <n-button :size="uiSizeStore.uiSize" v-permission="'ai-channel:save'" type="primary" @click="handleCreate">
                <mb-icon icon="AddOutline" /> 添加渠道
            </n-button>
            <n-button :size="uiSizeStore.uiSize" @click="reload">
                <mb-icon icon="RefreshOutline" /> 刷新
            </n-button>
        </div>
        <div class="mb-table">
            <mb-table ref="table" v-bind="tableOptions" :data="rows" :page="false"/>
        </div>

        <mb-modal ref="formDialog" :title="dialogTitle" width="720px" @confirm="save($event)">
            <n-form :size="uiSizeStore.uiSize" ref="dataForm" :rules="rules" label-placement="left" :model="temp" label-width="110px">
                <n-form-item label="渠道名称" path="name">
                    <n-input v-model:value="temp.name" placeholder="如 官网客服 / 小程序客服"/>
                </n-form-item>
                <n-form-item label="品牌名" path="brandName">
                    <n-input v-model:value="temp.brandName" placeholder="H5 顶部显示的品牌名"/>
                </n-form-item>
                <n-form-item label="品牌头像" path="avatar">
                    <n-input v-model:value="temp.avatar" placeholder="头像 URL（可空）"/>
                </n-form-item>
                <n-form-item label="欢迎语" path="welcome">
                    <n-input type="textarea" :rows="2" v-model:value="temp.welcome" placeholder="客户进入 H5 时的欢迎语"/>
                </n-form-item>
                <n-form-item label="免责声明" path="disclaimer">
                    <n-input type="textarea" :rows="2" v-model:value="temp.disclaimer" placeholder="底部免责声明"/>
                </n-form-item>
                <n-form-item label="主题色" path="themeColor">
                    <n-input v-model:value="temp.themeColor" placeholder="如 #1677ff"/>
                </n-form-item>
                <n-form-item label="允许域名" path="allowedDomains">
                    <n-input type="textarea" :rows="2" v-model:value="temp.allowedDomains" placeholder="JSON 数组，如 [&quot;example.com&quot;]；留空=不限制"/>
                </n-form-item>
                <n-form-item label="H5 工具" path="toolKeys">
                    <n-input type="textarea" :rows="2" v-model:value="temp.toolKeys" placeholder="JSON 数组，tool_key 白名单；留空=用默认"/>
                </n-form-item>
                <n-form-item label="限流" path="rateLimit">
                    <n-input v-model:value="temp.rateLimit" placeholder="次/分钟/访客，留空=不限"/>
                </n-form-item>
                <n-form-item label="状态" path="status">
                    <mb-select v-model="temp.status" :options="statusData"/>
                </n-form-item>
                <n-form-item label="备注" path="remarks">
                    <n-input type="textarea" :rows="2" v-model:value="temp.remarks"/>
                </n-form-item>
            </n-form>
        </mb-modal>
    </div>
</template>

<script setup>
import { ref, reactive, nextTick } from 'vue'
import { useUiSizeStore } from '@/store/modules/uiSizeStore'

const uiSizeStore = useUiSizeStore()
const table = ref()
const formDialog = ref()
const dataForm = ref()
const rows = ref([])
const dialogTitle = ref('')

const statusData = reactive([{ label: '启用', value: 'active' }, { label: '停用', value: 'disabled' }])

const tableOptions = reactive({
    id: 'ai-channel-list',
    rowKey: 'id',
    cols: [
        { field: 'name', label: '渠道名称', width: 160 },
        { field: 'brandName', label: '品牌名', width: 140 },
        { field: 'themeColor', label: '主题色', width: 90, render: (row) => row.themeColor || '-' },
        { field: 'rateLimit', label: '限流', width: 80, render: (row) => (row.rateLimit == null ? '不限' : row.rateLimit + '/分') },
        { field: 'allowedDomains', label: '允许域名', minWidth: 140, render: (row) => (row.allowedDomains ? row.allowedDomains : '不限制') },
        {
            field: 'status', label: '状态', width: 80,
            render: (row) => {
                const it = statusData.find(x => x.value === row.status)
                return it ? it.label : (row.status || '')
            }
        },
        {
            label: '操作', type: 'buttons', width: 160, fixed: 'right',
            buttons: [
                { permission: 'ai-channel:save', label: '修改', link: true, click: (row) => handleUpdate(row) },
                { permission: 'ai-channel:delete', label: '删除', link: true, click: (row) => del(row) }
            ]
        }
    ]
})

const temp = ref(getTemp())
const rules = reactive({
    name: { required: true, message: '请输入渠道名称', trigger: 'blur' }
})

function getTemp() {
    return { id: '', name: '', brandName: '', avatar: '', welcome: '', disclaimer: '', themeColor: '#1677ff', allowedDomains: '', toolKeys: '', rateLimit: '', status: 'active', remarks: '' }
}

function reload() {
    $common.get('/system/ai-channels/list').then(res => {
        rows.value = res.data || []
    }).catch(() => {})
}

function handleCreate() {
    temp.value = getTemp()
    dialogTitle.value = '添加渠道'
    formDialog.value.show()
    nextTick(() => dataForm.value.restoreValidation())
}

function handleUpdate(row) {
    temp.value = { ...getTemp(), ...row, rateLimit: row.rateLimit == null ? '' : String(row.rateLimit) }
    dialogTitle.value = '修改渠道'
    formDialog.value.show()
    nextTick(() => dataForm.value.restoreValidation())
}

function save(d) {
    dataForm.value.validate((errors) => {
        if (!errors) {
            d.loading()
            const payload = { ...temp.value }
            payload.rateLimit = payload.rateLimit === '' ? null : Number(payload.rateLimit)
            $common.post('/system/ai-channels/save', payload).then(() => {
                d.hideLoading()
                formDialog.value.hide()
                $message.success(dialogTitle.value + '成功')
                reload()
            }).catch(() => d.hideLoading())
        }
    })
}

function del(row) {
    $common.handleDelete({ url: '/system/ai-channels/delete', id: row.id, done: () => reload() })
}

reload()
</script>
