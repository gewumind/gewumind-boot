================================
<template>
    <div class="mb-list">
        <div class="card-base" style="padding:14px 16px;">
            <div style="background:rgba(242,244,247,.55);border:1px solid #f0f1f3;border-radius:6px;padding:10px 12px;display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;">
                <label style="display:flex;flex-direction:column;gap:4px;">
                    <span style="font-size:0.8rem;color:#86909c;">订单号</span>
                    <n-input :size="$global.uiSize.value" v-model:value="search.orderNo" placeholder="搜索订单号" style="width:200px" @keyup.enter="reloadTable">
                        <template #prefix><mb-icon icon="SearchOutline" /></template>
                    </n-input>
                </label>
                <label style="display:flex;flex-direction:column;gap:4px;">
                    <span style="font-size:0.8rem;color:#86909c;">状态</span>
                    <n-select :size="$global.uiSize.value" v-model:value="search.status" :options="statusOptions" placeholder="全部" clearable style="width:150px" @update:value="reloadTable" />
                </label>
                <button class="btn btn-primary" style="padding:6px 14px;" @click="reloadTable">查询</button>
                <button class="btn btn-ghost" style="padding:6px 14px;" @click="() => { search.orderNo=''; search.status=null; reloadTable() }">重置</button>
                <div style="margin-left:auto;display:flex;align-items:center;gap:10px;">
                    <span class="badge badge-gray">订单数据 · 可编辑</span>
                    <span style="font-size:0.73rem;color:#86909c;">共 {{ total }} 条订单</span>
                    <button class="btn btn-primary" style="padding:6px 14px;" @click="handleAdd" v-permission="'order:save'">+ 新增订单</button>
                </div>
            </div>
            <div style="overflow-x:auto;margin-top:12px;">
                <table class="data-table" style="width:100%;">
                    <thead>
                        <tr><th>订单号</th><th>客户</th><th>金额</th><th>状态</th><th>创建时间</th><th style="width:120px;">操作</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="row in paged" :key="row.id">
                            <td style="font-family:ui-monospace,Menlo,monospace;">{{ row.orderNo }}</td>
                            <td>{{ row.customerName }}</td>
                            <td>{{ row.amount }}</td>
                            <td><span :class="['badge', statusBadge(row.status)]">{{ row.status }}</span></td>
                            <td style="color:#86909c;">{{ row.createDate }}</td>
                            <td style="white-space:nowrap;">
                                <span style="color:var(--color-primary,#2D8CF0);cursor:pointer;" @click="handleUpdate(row)" v-permission="'order:save'">修改</span>
                                <span style="color:#c9cdd4;margin:0 6px;">|</span>
                                <span style="color:#d03050;cursor:pointer;" @click="deleteOrder(row)" v-permission="'order:delete'">删除</span>
                            </td>
                        </tr>
                        <tr v-if="!total"><td colspan="6" style="text-align:center;color:#a9aeb8;padding:32px 0;font-size:0.8rem;">没有符合条件的订单</td></tr>
                    </tbody>
                </table>
            </div>
            <div v-if="total" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 4px;border-top:1px solid #f0f1f3;font-size:0.87rem;color:#4e5969;">
                <span>共 <b style="color:#1d2129;font-family:monospace;">{{ total }}</b> 条订单，第 <b style="color:#1d2129;font-family:monospace;">{{ page }}</b> / {{ pages }} 页</span>
                <span style="margin-left:4px;">每页
                    <select v-model.number="size" style="background:#fff;border:1px solid #d9dde3;border-radius:4px;padding:2px 6px;font-size:0.87rem;color:#1d2129;">
                        <option :value="10">10</option><option :value="20">20</option><option :value="50">50</option>
                    </select> 条
                </span>
                <span style="color:#c9cdd4;">当前显示 {{ (page-1)*size+1 }}-{{ Math.min(page*size, total) }}</span>
                <div style="margin-left:auto;display:flex;align-items:center;gap:4px;">
                    <button class="pg-btn" :disabled="page<=1" @click="page=1">«</button>
                    <button class="pg-btn" :disabled="page<=1" @click="page--">‹ 上一页</button>
                    <button v-for="p in pageButtons" :key="p" class="pg-btn" :class="{ 'pg-active': p===page }" @click="page=p">{{ p }}</button>
                    <button class="pg-btn" :disabled="page>=pages" @click="page++">下一页 ›</button>
                    <button class="pg-btn" :disabled="page>=pages" @click="page=pages">»</button>
                </div>
            </div>
        </div>

        <mb-modal :size="$global.uiSize.value" ref="formDialog" width="640px" :title="dialogTitle" @confirm="save($event)">
            <n-form :size="$global.uiSize.value" ref="dataForm" :rules="rules" :model="temp" label-placement="left" label-width="90px">
                <n-grid :cols="24" :x-gap="24">
                    <n-gi :span="12"><n-form-item label="订单号" path="orderNo"><n-input v-model:value="temp.orderNo"/></n-form-item></n-gi>
                    <n-gi :span="12"><n-form-item label="客户" path="customerId"><n-select v-model:value="temp.customerId" :options="customerOptions" filterable/></n-form-item></n-gi>
                </n-grid>
                <n-grid :cols="24" :x-gap="24">
                    <n-gi :span="12"><n-form-item label="金额" path="amount"><n-input-number v-model:value="temp.amount" :min="0" :precision="2" style="width: 100%"/></n-form-item></n-gi>
                    <n-gi :span="12"><n-form-item label="状态" path="status"><n-select v-model:value="temp.status" :options="statusOptions"/></n-form-item></n-gi>
                </n-grid>
            </n-form>
        </mb-modal>
    </div>
</template>

<script setup>
import {ref, reactive, computed, watch, onMounted} from 'vue'

const search = reactive({orderNo: '', status: null})
const tableOptions = reactive({ loading: false, data: [] })
const statusOptions = [
    {label: '待付款', value: '待付款'},
    {label: '已付款', value: '已付款'},
    {label: '已完成', value: '已完成'},
    {label: '已取消', value: '已取消'}
]
const customerOptions = ref([])
const dialogTitle = ref('')
const temp = ref(getTemp())
const rules = reactive({
    orderNo: {required: true, message: '请输入订单号', trigger: 'blur'},
    customerId: {required: true, message: '请选择客户', trigger: 'change'},
    status: {required: true, message: '请选择状态', trigger: 'change'}
})
const formDialog = ref()
const dataForm = ref()

const page = ref(1)
const size = ref(10)
const total = computed(() => tableOptions.data.length)
const pages = computed(() => Math.max(1, Math.ceil(total.value / size.value)))
const paged = computed(() => tableOptions.data.slice((page.value - 1) * size.value, page.value * size.value))
const pageButtons = computed(() => {
    const arr = []
    const start = Math.max(1, Math.min(page.value - 1, Math.max(1, pages.value - 2)))
    for (let p = start; p <= Math.min(pages.value, start + 2); p++) arr.push(p)
    return arr
})
watch([total, size], () => { if (page.value > pages.value) page.value = pages.value })

function statusBadge(s) {
    return ({'待付款': 'badge-warn', '已付款': 'badge-blue', '已完成': 'badge-good', '已取消': 'badge-gray'})[s] || 'badge-gray'
}

onMounted(() => { loadCustomers(); reloadTable() })

function getTemp() { return {id: '', orderNo: '', customerId: null, amount: 0, status: '待付款'} }
function resetTemp() { temp.value = getTemp() }

function loadCustomers() {
    $common.get('/business/customer/list', {size: 200}).then(res => {
        customerOptions.value = (res.data.list || []).map(c => ({label: c.name, value: c.id}))
    })
}

function reloadTable() {
    tableOptions.loading = true
    const params = {size: 200}
    if (search.orderNo) params.orderNo = search.orderNo
    if (search.status) params.status = search.status
    $common.get('/business/order/list', params).then(res => {
        tableOptions.data = res.data.list || []
        tableOptions.loading = false
    }).catch(() => tableOptions.loading = false)
}

function handleAdd() { resetTemp(); dialogTitle.value = '新增订单'; formDialog.value.show() }
function handleUpdate(row) {
    temp.value = {id: row.id, orderNo: row.orderNo, customerId: row.customerId, amount: row.amount, status: row.status}
    dialogTitle.value = '修改订单'
    formDialog.value.show()
}
function deleteOrder(row) {
    $common.handleDelete({url: '/business/order/delete', id: row.id, done: () => reloadTable()})
}
function save(d) {
    dataForm.value.validate((errors) => {
        if (!errors) {
            d.loading()
            $common.post('/business/order/save', temp.value).then(() => {
                d.hideLoading(); $message.success(dialogTitle.value + '成功'); formDialog.value.hide(); reloadTable()
            }).catch(() => d.hideLoading())
        }
    })
}
</script>
